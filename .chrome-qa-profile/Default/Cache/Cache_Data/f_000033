  function normalizeOrder(raw){
    const src = raw && typeof raw === 'object' ? raw : null;
    if (!src) return null;
    const createdAt = src.criadoEm || src.data || todayISO();
    const itens = Array.isArray(src.itens)
      ? src.itens
      : (src.itens ? [String(src.itens)] : []);

    return {
